{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大肥鱼助手",
  "mainBinaryName": "大肥鱼助手",
  "identifier": "com.aiwork.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "大肥鱼助手",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "maximized": true
      },
      {
        "label": "pet",
        "title": "大肥鱼桌宠",
        "url": "index.html?pet=1",
        "width": 532,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "D:/work/app-data/pets/**",
          "$APPDATA/AIWorkAssistant/pets/**"
        ]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "大肥鱼多账号签到与管理助手",
    "longDescription": "整合多账号签到、登录态切换、设备隔离与账号分组的 Windows 桌面端工具，支持 Trae / WorkBuddy / 豆包等多应用扩展。",
    "publisher": "大肥鱼助手",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installerHooks": "../build-assets/installer-hooks.nsh",
        "template": "../build-assets/installer.nsi"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "https?://\\S+"
    }
  }
}
