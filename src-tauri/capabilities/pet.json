{
  "identifier": "pet",
  "description": "桌宠窗口权限（最小集）：仅拖拽与窗口自控；显隐/置顶/位置记忆由 Rust 命令负责，业务事件靠 core:default 里的 event:listen 订阅",
  "windows": ["pet"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
